{% doc %}
  Renders the store's supported payment types as accessible SVG icons.

  @example
  {% render 'supported-payment-types' %}
{% enddoc %}

<ul
  class="supported-payment-types flex nowrap"
  aria-label="{{ 'snippets.supported_payment_types.list_label' | t | escape }}"
>
  {% for type in shop.enabled_payment_types %}
    <li class="supported-payment-types__item">
      {{ type | payment_type_svg_tag }}
    </li>
  {% else %}
    <li class="supported-payment-types__item supported-payment-types__item--empty">
      <span class="supported-payment-types__text">
        {{ 'snippets.supported_payment_types.none' | t | escape }}
      </span>
    </li>
  {% endfor %}
</ul>
