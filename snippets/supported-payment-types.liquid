{% doc %}
  Renders the store's supported payment types as accessible SVG icons.

  @example
  {% render 'supported-payment-types' %}
{% enddoc %}

<ul
  class="supported-payment-types"
  aria-label="{{ 'snippets.supported_payment_types.list_label' | t | escape }}"
>
  {% for type in shop.enabled_payment_types %}
    <li class="supported-payment-types__item">
      {{ type | payment_type_svg_tag }}
    </li>
  {% else %}
    <li class="supported-payment-types__item supported-payment-types__item--empty">
      <span class="supported-payment-types__text">
        {{ 'snippets.supported_payment_types.none' | t | escape }}
      </span>
    </li>
  {% endfor %}
</ul>

{% stylesheet %}
  .supported-payment-types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .supported-payment-types__item {
    display: inline-flex;
    align-items: center;
  }

  .supported-payment-types__item svg {
    width: 2.4rem;
    height: 1.6rem;
  }

  .supported-payment-types__item--empty {
    font-size: 0.875rem;
    color: #6b7280;
  }
{% endstylesheet %}