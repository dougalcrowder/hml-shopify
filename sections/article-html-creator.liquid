{% assign js_id = section.id | replace: '-', '_' %}

<div class="html-creator" id="html-creator-{{ section.id }}" style="display:none">
  <div class="html-creator__header">
    <span class="html-creator__title">Section HTML</span>
    <div class="html-creator__actions">
      <button
        class="html-creator__btn html-creator__generate-btn"
        onclick="htmlCreatorGenerate_{{ js_id }}()">
        Generate HTML
      </button>
      <button
        class="html-creator__btn html-creator__copy-btn"
        id="html-copy-btn-{{ js_id }}"
        onclick="htmlCreatorCopy_{{ js_id }}()"
        disabled>
        Copy HTML
      </button>
    </div>
  </div>
  <textarea
    class="html-creator__output"
    id="html-output-{{ js_id }}"
    readonly
    spellcheck="false"
    placeholder="Click 'Generate HTML' to capture sections above this one."></textarea>
</div>

<style>
  #html-creator-{{ section.id }} {
    font-family: monospace;
    background: #1e1e1e;
    border: 1px solid #444;
    border-radius: 6px;
    overflow: hidden;
    margin: 1rem 0;
  }
  #html-creator-{{ section.id }} .html-creator__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: #2d2d2d;
    border-bottom: 1px solid #444;
  }
  #html-creator-{{ section.id }} .html-creator__title {
    color: #ccc;
    font-size: 13px;
  }
  #html-creator-{{ section.id }} .html-creator__actions {
    display: flex;
    gap: 6px;
  }
  #html-creator-{{ section.id }} .html-creator__btn {
    color: #fff;
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 12px;
    cursor: pointer;
  }
  #html-creator-{{ section.id }} .html-creator__generate-btn {
    background: #2e7d32;
  }
  #html-creator-{{ section.id }} .html-creator__generate-btn:hover {
    background: #388e3c;
  }
  #html-creator-{{ section.id }} .html-creator__copy-btn {
    background: #0078d4;
  }
  #html-creator-{{ section.id }} .html-creator__copy-btn:hover:not(:disabled) {
    background: #106ebe;
  }
  #html-creator-{{ section.id }} .html-creator__copy-btn:disabled {
    background: #555;
    cursor: default;
    opacity: 0.6;
  }
  #html-creator-{{ section.id }} .html-creator__output {
    display: block;
    width: 100%;
    min-height: 300px;
    padding: 12px;
    background: #1e1e1e;
    color: #d4d4d4;
    font-size: 12px;
    line-height: 1.5;
    border: none;
    resize: vertical;
    box-sizing: border-box;
    white-space: pre;
    tab-size: 2;
  }
  #html-creator-{{ section.id }} .html-creator__output:focus {
    outline: none;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (window.Shopify && window.Shopify.designMode) {
      document.getElementById('html-creator-{{ section.id }}').style.display = 'block';
    }
  });

  function htmlCreatorGenerate_{{ js_id }}() {
    function formatHtml(html) {
      var indent = 0;
      var tab = '  ';
      return html
        .replace(/></g, '>\n<')
        .split('\n')
        .map(function (line) {
          line = line.trim();
          if (!line) return '';
          if (/^<\//.test(line)) indent = Math.max(0, indent - 1);
          var out = tab.repeat(indent) + line;
          if (/^<[^\/!][^>]*[^\/]>$/.test(line) && !/^<(area|base|br|col|embed|hr|img|input|link|meta|param|source|track|wbr)/i.test(line)) {
            indent++;
          }
          return out;
        })
        .filter(function (l) { return l !== ''; })
        .join('\n');
    }

    var thisSection = document.getElementById('html-creator-{{ section.id }}').closest('.shopify-section');
    var all = Array.from(document.querySelectorAll('.shopify-section'));
    var idx = all.indexOf(thisSection);
    var preceding = idx > 0 ? all.slice(0, idx) : [];

    var combined = preceding.map(function (el) {
      return formatHtml(el.outerHTML);
    }).join('\n\n');

    var textarea = document.getElementById('html-output-{{ js_id }}');
    var copyBtn = document.getElementById('html-copy-btn-{{ js_id }}');
    textarea.value = combined || '(no sections found above this one)';
    copyBtn.disabled = !combined;
  }

  function htmlCreatorCopy_{{ js_id }}() {
    var textarea = document.getElementById('html-output-{{ js_id }}');
    var btn = document.getElementById('html-copy-btn-{{ js_id }}');
    navigator.clipboard.writeText(textarea.value).then(function () {
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = 'Copy HTML'; }, 2000);
    }).catch(function () {
      textarea.select();
      document.execCommand('copy');
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = 'Copy HTML'; }, 2000);
    });
  }
</script>

{% schema %}
{
  "name": "HTML Creator",
  "templates": ["article"],
  "presets": [
    {
      "name": "HTML Creator"
    }
  ]
}
{% endschema %}
