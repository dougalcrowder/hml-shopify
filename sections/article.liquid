{{ 'section-article.css' | asset_url | stylesheet_tag }}

<article class="main-article">
  {% if section.settings.show_html %}
    {{ article.content }}
  {% else %}
    {%- if article.image and section.settings.show_image -%}
      <div class="article-image article-image--{{ section.settings.image_style }}">
        <img
          src="{{ article.image | image_url: width: 1800 }}"
          srcset="{{ article.image | image_url: width: 750 }} 750w,
                {{ article.image | image_url: width: 1100 }} 1100w,
                {{ article.image | image_url: width: 1500 }} 1500w,
                {{ article.image | image_url: width: 1800 }} 1800w"
          sizes="100vw"
          alt="{{ article.image.alt | default: article.title | escape }}"
          loading="eager"
          fetchpriority="high">
      </div>
    {%- endif -%}

    <header class="article-header article-constrained">

      <a href="{{ blog.url }}" class="article-back">
        &larr; {{ section.settings.back_label }}
      </a>

      <h1>{{ article.title }}</h1>

      {%- if section.settings.show_author or section.settings.show_date or section.settings.show_reading_time -%}
        <div class="article-meta">
          {%- if section.settings.show_author -%}
            <span class="article-author">{{ article.author }}</span>
          {%- endif -%}

          {%- if section.settings.show_date -%}
            {%- if section.settings.show_author -%}
              <span class="article-meta-divider" aria-hidden="true">&middot;</span>
            {%- endif -%}
            <time class="article-date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
              {{ article.published_at | date: "%d %B %Y" }}
            </time>
          {%- endif -%}

          {%- if section.settings.show_reading_time -%}
            {%- assign word_count = article.content | strip_html | split: ' ' | size -%}
            {%- assign reading_time = word_count | divided_by: 238.0 | ceil | at_least: 1 -%}
            {%- if section.settings.show_author or section.settings.show_date -%}
              <span class="article-meta-divider" aria-hidden="true">&middot;</span>
            {%- endif -%}
            <span class="article-reading-time">{{ reading_time }} min read</span>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_tags and article.tags.size > 0 -%}
        <div class="article-tags">
          {%- for tag in article.tags -%}
            <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="article-tag">{{ tag }}</a>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </header>

    <div class="article-body article-constrained">
      <div class="rte">
        {{ article.content }}
      </div>
    </div>

    {%- if section.settings.show_prev_next -%}
      {%- if blog.previous_article or blog.next_article -%}
        <nav class="article-nav article-constrained" aria-label="Article navigation">
          <div class="article-nav__inner">

            {%- if blog.previous_article -%}
              <a href="{{ blog.previous_article.url }}" class="article-nav__prev">
                <span class="article-nav__label">&larr; Previous</span>
                <span class="article-nav__title">{{ blog.previous_article.title }}</span>
              </a>
            {%- else -%}
              <span></span>
            {%- endif -%}

            {%- if blog.next_article -%}
              <a href="{{ blog.next_article.url }}" class="article-nav__next">
                <span class="article-nav__label">Next &rarr;</span>
                <span class="article-nav__title">{{ blog.next_article.title }}</span>
              </a>
            {%- endif -%}

          </div>
        </nav>
      {%- endif -%}
    {%- endif -%}
  {% endif %}
</article>

{% schema %}
  {
    "name": "Article",
    "settings": [
      {
        "type": "header",
        "content": "Post options"
      },
      {
        "type": "checkbox",
        "id": "show_html",
        "label": "Show code",
        "default": true
      },
      {
        "type": "header",
        "content": "Featured image"
      },
      {
        "type": "checkbox",
        "id": "show_image",
        "label": "Show featured image",
        "default": true
      }, {
        "type": "select",
        "id": "image_style",
        "label": "Image style",
        "options": [
          {
            "value": "full",
            "label": "Full bleed"
          }, {
            "value": "contained",
            "label": "Contained (830px)"
          }
        ],
        "default": "full"
      }, {
        "type": "header",
        "content": "Article info"
      }, {
        "type": "checkbox",
        "id": "show_author",
        "label": "Show author",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_date",
        "label": "Show date",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_reading_time",
        "label": "Show reading time",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_tags",
        "label": "Show tags",
        "default": true
      }, {
        "type": "header",
        "content": "Navigation"
      }, {
        "type": "text",
        "id": "back_label",
        "label": "Back link label",
        "default": "Back to Journal"
      }, {
        "type": "checkbox",
        "id": "show_prev_next",
        "label": "Show previous / next article",
        "default": true
      }
    ],
    "presets": [
      {
        "name": "Article"
      }
    ]
  }
{% endschema %}