<article class="{% if section.settings.narrow_page %}info{% else %}wider{% endif %}">
  {% if section.settings.show_title %}
    <h1 class="drukster outline page">{{ page.title }}</h1>
  {% endif %}
  {% if section.settings.show_content %}
    {% if page.metafields.custom.text_column_2.value != blank %}
      <div class="flex infoinners">
        <div class="firstblock">
          {{ page.content }}
        </div>
        <div class="secondblock">
          {{ page.metafields.custom.text_column_2 | metafield_tag }}
        </div>
      </div>
    {% else %}
      <div class="rte">{{ page.content }}</div>
    {% endif %}
  {% endif %}
</article>


{% schema %}
  {
    "name": "Page",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_title",
        "label": "Show Title",
        "default": true
      }, {
        "type": "checkbox",
        "id": "show_content",
        "label": "Show Content",
        "default": true
      }, {
        "type": "checkbox",
        "id": "narrow_page",
        "label": "Make page narrow",
        "default": true
      }
    ]
  }
{% endschema %}