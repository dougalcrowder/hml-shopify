{%- paginate blog.articles by 10 -%}
  {{ 'section-campaigns.css' | asset_url | stylesheet_tag }}

  <div id="content" class="ohmygaad">
    <div id="campaigns" class="campaigns">
      {%- for article in blog.articles -%}
        {{ article.content }}
      {%- endfor -%}
    </div>
  </div>
  {%- if paginate.next -%}
    <div id="load-more-container" style="text-align:center;padding:40px 0;">
      <button
        class="button"
        id="loadMoreBtn"
        data-next-url="{{ paginate.next.url }}">
        {{ section.settings.load_more_label }}
      </button>
    </div>
  {%- endif -%}

{%- endpaginate -%}

<script>
  (function () {
    var btn = document.getElementById('loadMoreBtn');
    if (!btn) return;

    var container = document.getElementById('blog-articles');
    var originalLabel = btn.textContent.trim();

    btn.addEventListener('click', function () {
      var nextUrl = btn.dataset.nextUrl;
      if (!nextUrl) return;

      btn.disabled = true;
      btn.textContent = 'Loading…';

      fetch(nextUrl)
        .then(function (res) {
          if (!res.ok) throw new Error(res.status);
          return res.text();
        })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');

          var incoming = doc.getElementById('blog-articles');
          if (incoming) {
            container.insertAdjacentHTML('beforeend', incoming.innerHTML);
          }

          var nextBtn = doc.getElementById('loadMoreBtn');
          if (nextBtn) {
            btn.dataset.nextUrl = nextBtn.dataset.nextUrl;
            btn.disabled = false;
            btn.textContent = originalLabel;
          } else {
            document.getElementById('load-more-container').remove();
          }
        })
        .catch(function () {
          btn.disabled = false;
          btn.textContent = originalLabel;
        });
    });
  })();
</script>

<script src="{{ 'rellax.min.js' | asset_url }}" defer="defer"></script>

<script>
  if (document.querySelector('.rellax')) {
  window.addEventListener('load', function() {
    var rellax = new Rellax('.rellax', {
      speed: -2,
      center: true
    });
  })
  }

  var inactivityTime = function () {
    var time;
    window.onload = resetTimer;
    document.onload = resetTimer;
    document.onmousemove = resetTimer;
    document.onmousedown = resetTimer; 
    document.ontouchstart = resetTimer;
    document.onclick = resetTimer;  
    document.onscroll = resetTimer; 
    document.onkeypress = resetTimer;

    function gowild() {
        if (document.getElementById('campaigns')) {
          let content = document.getElementById('content');
          content.classList.remove('settle');
          content.classList.add('ohmygaad');
        }
    }

    function resetTimer() {
        clearTimeout(time);
        let content = document.getElementById('content');
        if (content.classList.contains('ohmygaad')) {
          content.classList.remove('ohmygaad');
          content.classList.add('settle');
        }
        time = setTimeout(gowild, 20000)
        // 1000 milliseconds = 1 second
    }
  };
  inactivityTime();
</script>

{% schema %}
  {
    "name": "Blog",
    "settings": [
      {
        "type": "text",
        "id": "load_more_label",
        "label": "Load more button label",
        "default": "Load more"
      }
    ],
    "presets": [
      {
        "name": "Blog"
      }
    ]
  }
{% endschema %}