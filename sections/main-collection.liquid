{%- if section.settings.enable_filtering -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="collection-page" data-id="{{ section.id }}">
  {%- paginate collection.products by section.settings.products_per_page -%}

    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
      <div class="facets-container page-width">
        {% render 'facets'
          , results: collection
          , enable_filtering: section.settings.enable_filtering
          , enable_sorting: section.settings.enable_sorting
          , filter_type: section.settings.filter_type
        %}
      </div>
    {%- endif -%}
    {%- if section.settings.sticky_nav -%}
      <div class="header_placeholder" id="navSentinal" style="width: 100%; height: 48px"> </div>
    {%- endif -%}
    <div class="swag" id="swag">
      <div
        class="products grid containerCat collection{% if collection.products_count == 0 %} is-empty{% endif %}"
        id="product-grid"
        data-id="{{ section.id }}">
        {%- if collection.products.size == 0 -%}
          <div class="collection-product-list" data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t }}<br>
                {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: "underlined-link link" }}
              </h2>
            </div>
          </div>
        {%- else -%}
          {%- for product in collection.products -%}
            {% render 'product-card'
              , product: product
              , section_id: section.id %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!--
      Pagination: rendered for no-JS users.
      JS will hide this and inject a Load More button instead.
    -->
    {%- if paginate.pages > 1 -%}
      <div class="pagination-wrapper" id="pagination-wrapper">
        {% render 'pagination'
          , paginate: paginate
          , anchor: '' %}
      </div>
    {%- endif -%}

  {%- endpaginate -%}
</div>

<script>
  (function () {
  var grid = document.getElementById('product-grid');
  if (!grid) return;

  var LOAD_MORE_TEXT = {{ 'sections.collection_template.load_more' | t | json }};
  var LOADING_TEXT   = {{ 'accessibility.loading' | t | json }};

  function getNextUrl(container) {
    if (!container) return null;
    var link = container.querySelector('a[aria-label="Next page"]');
    return link ? link.href : null;
  }

  var nextUrl = null;
  var btn     = null;
  var btnWrap = null;

  function createButton() {
    btn = document.createElement('button');
    btn.className = 'button load-more-btn';
    btn.textContent = LOAD_MORE_TEXT;
    btn.setAttribute('aria-label', LOAD_MORE_TEXT);
    btnWrap = document.createElement('div');
    btnWrap.className = 'swag load-more-wrapper text-center';
    btnWrap.appendChild(btn);
    btn.addEventListener('click', handleClick);
  }

  function handleClick() {
    if (!nextUrl) return;
    btn.disabled    = true;
    btn.textContent = LOADING_TEXT;
    fetch(nextUrl)
      .then(function (res) {
        if (!res.ok) throw new Error('Network response was not ok');
        return res.text();
      })
      .then(function (html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        var remoteGrid = doc.getElementById('product-grid');
        if (remoteGrid) {
          Array.from(remoteGrid.childNodes).forEach(function (node) {
            grid.appendChild(document.importNode(node, true));
          });
        }
        nextUrl = getNextUrl(doc.getElementById('pagination-wrapper'));
        if (nextUrl) {
          btn.disabled    = false;
          btn.textContent = LOAD_MORE_TEXT;
        } else {
          btnWrap.remove();
          btnWrap = null;
          btn     = null;
        }
      })
      .catch(function (err) {
        console.error('[Load More] Failed to fetch next page:', err);
        btn.disabled    = false;
        btn.textContent = LOAD_MORE_TEXT;
      });
  }

  window.syncLoadMore = function (sectionHtml) {
    var doc = new DOMParser().parseFromString(sectionHtml, 'text/html');
    nextUrl = getNextUrl(doc.getElementById('pagination-wrapper'));
    if (nextUrl) {
      if (!btn) createButton();
      if (!btnWrap.parentNode) {
        var anchor = document.getElementById('pagination-wrapper') || grid.parentNode;
        anchor.insertAdjacentElement('afterend', btnWrap);
      }
      btn.disabled    = false;
      btn.textContent = LOAD_MORE_TEXT;
    } else if (btnWrap) {
      btnWrap.remove();
      btnWrap = null;
      btn     = null;
    }
  };

  var paginationWrap = document.getElementById('pagination-wrapper');
  nextUrl = getNextUrl(paginationWrap);
  if (nextUrl) {
    createButton();
    paginationWrap.hidden = true;
    paginationWrap.insertAdjacentElement('afterend', btnWrap);
  }
  })();
</script>

{% if section.settings.sticky_nav %}
<script>
(function () {
  'use strict';

  var headerSection = document.getElementById('shopify-section-header');
  var sentinel      = document.getElementById('navSentinal');

  if (!headerSection || !sentinel) return;

  // Fix the header in place but let it track the sentinel position
  headerSection.style.cssText =
    'position:fixed!important;left:0;right:0;width:100%;z-index:99991;transition:none!important;';

  var ticking = false;

  function update() {
    var sentinelTop = sentinel.getBoundingClientRect().top;
    headerSection.style.top = Math.max(0, sentinelTop) + 'px';
    ticking = false;
  }

  window.addEventListener('scroll', function () {
    if (!ticking) {
      requestAnimationFrame(update);
      ticking = true;
    }
  }, { passive: true });

  // Set initial position on load
  update();

  document.getElementById('catGrid').addEventListener('click', function () {
    sentinel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

})();
</script>
{% endif %}
{% schema %}
  {
    "name": "Product Grid",
    "class": "section z8 relative",
    "settings": [
      {
        "type": "header",
        "content": "Product Grid"
      },
      {
        "type": "range",
        "id": "products_per_page",
        "min": 12,
        "max": 48,
        "step": 12,
        "default": 24,
        "label": "Products per page"
      },
      {
        "type": "header",
        "content": "Filtering and Sorting"
      },
      {
        "type": "checkbox",
        "id": "enable_filtering",
        "label": "Enable filtering",
        "default": true,
        "info": "Uses Dawn's faceted filtering system"
      }, {
        "type": "select",
        "id": "filter_type",
        "options": [
          {
            "value": "horizontal",
            "label": "Horizontal"
          }, {
            "value": "vertical",
            "label": "Vertical"
          }, {
            "value": "drawer",
            "label": "Drawer"
          }
        ],
        "default": "drawer",
        "label": "Filter layout",
        "info": "Drawer is recommended for mobile-first design"
      }, {
        "type": "checkbox",
        "id": "enable_sorting",
        "label": "Enable sorting",
        "default": true
      }, {
        "type": "checkbox",
        "id": "sticky_nav",
        "label": "Push sticky nav below content",
        "default": false
      }
    ]
  }
{% endschema %}