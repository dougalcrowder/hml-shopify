{%- if section.settings.enable_filtering -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<div class="collection-page" data-id="{{ section.id }}">
  {%- paginate collection.products by section.settings.products_per_page -%}

    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
      <div class="facets-container page-width">
        {% render 'facets'
          , results: collection
          , enable_filtering: section.settings.enable_filtering
          , enable_sorting: section.settings.enable_sorting
          , filter_type: section.settings.filter_type
        %}
      </div>
    {%- endif -%}
    {%- if section.settings.sticky_nav -%}
      <div class="header_placeholder" id="navSentinal" style="width: 100%; height: 48px"> </div>
    {%- endif -%}
    <div class="swag" id="swag">
      <div
        class="products grid containerCat{% if collection.products_count == 0 %} is-empty{% endif %}"
        id="grid"
        data-id="{{ section.id }}">
        {%- if collection.products.size == 0 -%}
          <div
            class="collection-product-list"
            id="product-grid"
            data-id="{{ section.id }}">
            <div class="loading-overlay gradient"></div>
            <div class="title-wrapper center">
              <h2 class="title title--primary">
                {{ 'sections.collection_template.empty' | t }}<br>
                {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: "underlined-link link" }}
              </h2>
            </div>
          </div>
        {%- else -%}
          {%- for product in collection.products -%}
            {% render 'product-card'
              , product: product
              , section_id: section.id %}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>

    <!--
      Pagination: rendered for no-JS users.
      JS will hide this and inject a Load More button instead.
    -->
    {%- if paginate.pages > 1 -%}
      <div class="pagination-wrapper" id="pagination-wrapper">
        {% render 'pagination'
          , paginate: paginate
          , anchor: '' %}
      </div>
    {%- endif -%}

  {%- endpaginate -%}
</div>

<script>
  (function () {
  var grid            = document.getElementById('grid');
  var paginationWrap  = document.getElementById('pagination-wrapper');

  // If there's no grid or no pagination, nothing to do.
  if (!grid || !paginationWrap) return;

  // Find the "next page" link Dawn's pagination snippet renders.
  // Dawn uses rel="next" on the <a> tag for the next-page link.
  function getNextUrl(container) {
  var link = container.querySelector('a[aria-label="Next page"]');
  return link ? link.href : null;
  }

  var nextUrl = getNextUrl(paginationWrap);

  // No next page — leave pagination as-is.
  if (!nextUrl) return;

  // JS is available: hide numbered pagination, inject Load More button.
  paginationWrap.hidden = true;

  var btn = document.createElement('button');
  btn.className   = 'button load-more-btn';
  btn.textContent = {{ 'sections.collection_template.load_more' | t | json }};
  btn.setAttribute('aria-label', btn.textContent);

  var btnWrap = document.createElement('div');
  btnWrap.className = 'swag load-more-wrapper text-center';
  btnWrap.appendChild(btn);
  paginationWrap.insertAdjacentElement('afterend', btnWrap);

  btn.addEventListener('click', function () {
    if (!nextUrl) return;

    btn.disabled    = true;
    btn.textContent = {{ 'general.accessibility.loading' | t | json }};

    fetch(nextUrl)
      .then(function (res) {
        if (!res.ok) throw new Error('Network response was not ok');
        return res.text();
      })
      .then(function (html) {
        // Parse the fetched page.
        var parser  = new DOMParser();
        var doc     = parser.parseFromString(html, 'text/html');

        // Extract product cards from the remote grid.
        var remoteGrid = doc.getElementById('grid');
        if (remoteGrid) {
          // Move each child node into the live grid.
          Array.from(remoteGrid.childNodes).forEach(function (node) {
            grid.appendChild(document.importNode(node, true));
          });
        }

        // Find the next page's "next" link from the remote pagination block.
        var remotePagination = doc.getElementById('pagination-wrapper');
        nextUrl = remotePagination ? getNextUrl(remotePagination) : null;

        if (nextUrl) {
          // More pages still exist — re-enable the button.
          btn.disabled    = false;
          btn.textContent = {{ 'sections.collection_template.load_more' | t | json }};
        } else {
          // No more pages — remove the button entirely.
          btnWrap.remove();
        }
      })
      .catch(function (err) {
        console.error('[Load More] Failed to fetch next page:', err);
        btn.disabled    = false;
        btn.textContent = {{ 'sections.collection_template.load_more' | t | json }};
      });
  });
  })();
</script>

{% if section.settings.sticky_nav %}
<script>
  (function () {
  'use strict';

  var headerSection = document.getElementById('shopify-section-header');
  var productGrid   = document.querySelector('[id$="__product-grid"]');

  if (!headerSection || !productGrid) return;

  var headerH = headerSection.offsetHeight;

  // ─── Override the CSS sticky so header scrolls freely on load ────────────
  headerSection.style.position = 'relative';

  // ─── Activate: switch to fixed when grid reaches header bottom ───────────
  function activate() {
    headerSection.style.cssText =
      'position:fixed!important;top:0;left:0;right:0;z-index:99992;width:100%;';
  }

  // ─── Deactivate: back to scrolling freely ────────────────────────────────
  function deactivate() {
    headerSection.style.cssText = 'position:relative;';
  }

  var isFixed  = false;
  var observer;

  function buildObserver() {
    if (observer) observer.disconnect();

    observer = new IntersectionObserver(
      function (entries) {
        var e           = entries[0];
        var aboveView   = !e.isIntersecting && e.boundingClientRect.top < 0;

        if (aboveView === isFixed) return;
        isFixed = aboveView;
        aboveView ? activate() : deactivate();
      },
      {
        threshold  : 0,
        rootMargin : '-' + headerH + 'px 0px 0px 0px'
      }
    );

    observer.observe(productGrid);
  }

  buildObserver();

  // ─── Resize ───────────────────────────────────────────────────────────────
  var resizeTimer;
  window.addEventListener('resize', function () {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(function () {
      headerH = headerSection.offsetHeight;
      buildObserver();
    }, 150);
  }, { passive: true });

})();
</script>
{% endif %}
{% schema %}
  {
    "name": "Product Grid",
    "class": "section z8 relative",
    "settings": [
      {
        "type": "header",
        "content": "Product Grid"
      },
      {
        "type": "range",
        "id": "products_per_page",
        "min": 12,
        "max": 48,
        "step": 12,
        "default": 24,
        "label": "Products per page"
      },
      {
        "type": "header",
        "content": "Filtering and Sorting"
      },
      {
        "type": "checkbox",
        "id": "enable_filtering",
        "label": "Enable filtering",
        "default": true,
        "info": "Uses Dawn's faceted filtering system"
      }, {
        "type": "select",
        "id": "filter_type",
        "options": [
          {
            "value": "horizontal",
            "label": "Horizontal"
          }, {
            "value": "vertical",
            "label": "Vertical"
          }, {
            "value": "drawer",
            "label": "Drawer"
          }
        ],
        "default": "drawer",
        "label": "Filter layout",
        "info": "Drawer is recommended for mobile-first design"
      }, {
        "type": "checkbox",
        "id": "enable_sorting",
        "label": "Enable sorting",
        "default": true
      }, {
        "type": "checkbox",
        "id": "sticky_nav",
        "label": "Push sticky nav below content",
        "default": false
      }
    ]
  }
{% endschema %}