{% comment %}
  Footer - Hannah Martin
  Always loads section-footer.css
{% endcomment %}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}

<footer id="footer" class="siteFooter">
  <div class="footer-inner">
    <div class="footer-logotype">
      <a href="/" aria-label="Go to the homepage">
        <img
          class="svg"
          src="{{ 'hannah_martin-logotype.svg' | asset_url }}"
          width="410"
          height="29"
          alt="Hannah Martin Icon">
      </a>
    </div>

    <div class="flex navitems">

      {%- if section.settings.footer_menu_1 != blank -%}
        <div class="col1">
          {%- assign menu_1 = linklists[section.settings.footer_menu_1] -%}
          <nav class="collections">
            <h4>{{ menu_1.title }}</h4>
            <ul class="footNav">
              {%- for link in menu_1.links -%}
                <li>
                  <a itemprop="url" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </div>
      {%- endif -%}

      <div class="col2">
        {%- if section.settings.footer_menu_2 != blank -%}
          {%- assign menu_2 = linklists[section.settings.footer_menu_2] -%}
          <nav class="jewellery">
            <h4>{{ menu_2.title }}</h4>
            <ul class="footNav">
              {%- for link in menu_2.links -%}
                <li>
                  <a itemprop="url" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if section.settings.footer_menu_3 != blank -%}
          {%- assign menu_3 = linklists[section.settings.footer_menu_3] -%}
          <nav class="special">
            <h4>{{ menu_3.title }}</h4>
            <ul class="footNav">
              {%- for link in menu_3.links -%}
                <li>
                  <a itemprop="url" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>

      <div class="col3">
        {%- if section.settings.footer_menu_4 != blank -%}
          {%- assign menu_4 = linklists[section.settings.footer_menu_4] -%}
          <nav class="info">
            <h4>{{ menu_4.title }}</h4>
            <ul class="footNav">
              {%- for link in menu_4.links -%}
                <li>
                  <a itemprop="url" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if section.settings.footer_menu_5 != blank -%}
          {%- assign menu_5 = linklists[section.settings.footer_menu_5] -%}
          <nav class="follow">
            <h4>{{ menu_5.title }}</h4>
            <ul class="footNav">
              {%- for link in menu_5.links -%}
                <li>
                  <a
                    target="_blank"
                    rel="noopener"
                    itemprop="url"
                    href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      </div>

      <div class="col4">
        {%- if section.settings.footer_menu_6 != blank -%}
          {%- assign menu_6 = linklists[section.settings.footer_menu_6] -%}
          <nav class="about">
            <h4>{{ menu_6.title }}</h4>
            <ul class="footNav">
              {%- for link in menu_6.links -%}
                <li>
                  <a itemprop="url" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        <div class="news">
          <h4>Newsletter</h4>
          <form id="newsletterForm">
            <div class="hm-forms">
              <div class="freeform-row">
                <div class="freeform-column html">
                  <p>Sign up to our newsletter</p>
                </div>
              </div>
              <div class="freeform-row">
                <div class="freeform-column text">
                  <label for="form-input-firstName" class="freeform-label">First Name</label>
                  <input
                    class="freeform-input"
                    name="FNAME"
                    type="text"
                    id="form-input-firstName"
                    placeholder="First Name">
                </div>
                <div class="freeform-column text">
                  <label for="form-input-lastName" class="freeform-label">Last Name</label>
                  <input
                    class="freeform-input"
                    name="LNAME"
                    type="text"
                    id="form-input-lastName"
                    placeholder="Last Name">
                </div>
                <div class="freeform-column email">
                  <label for="form-input-newsletter-email" class="freeform-label freeform-required">Email</label>
                  <input
                    class="freeform-input"
                    name="EMAIL"
                    type="email"
                    id="form-input-newsletter-email"
                    placeholder="Email Address"
                    required>
                </div>
              </div>
              <div class="freeform-row">
                <div class="freeform-column html">
                  <small>By signing up, you accept the terms of Hannah Martin's
                    <a href="/pages/privacy-policy">Privacy Policy</a>.
                  </small>
                </div>
              </div>
              <div
                id="formMessage"
                class="form-message"
                role="alert"></div>
              <div class="freeform-row">
                <div class="freeform-column freeform-column-content-align-left submit">
                  <button
                    id="newsubscribe"
                    type="submit"
                    name="subscribe">Subscribe</button>
                </div>
              </div>
            </div>
          </form>
        </div>

        <script>
            document.getElementById('newsletterForm').addEventListener('submit', function(e) {
              e.preventDefault();

              var form = this;
              var btn = document.getElementById('newsubscribe');
              var msg = document.getElementById('formMessage');

              btn.disabled = true;
              btn.textContent = 'Subscribing…';
              msg.className = 'form-message';
              msg.textContent = '';

              var data = new FormData(form);
              var params = new URLSearchParams();
              data.forEach(function(value, key) { params.append(key, value); });

              var cbName = '_mc_cb_' + Date.now();
              var mcBase = {{ section.settings.mailchimp_url | default: '' | json }};
              var mcEndpoint = mcBase.replace(/\/post(?=\?|$)/, '/post-json');
              var url = mcEndpoint + (mcEndpoint.indexOf('?') === -1 ? '?' : '&') + params.toString() + '&c=' + cbName;

              window[cbName] = function(response) {
                delete window[cbName];
                if (script.parentNode) script.parentNode.removeChild(script);
                btn.disabled = false;
                btn.textContent = 'Subscribe';
                if (response.result === 'success') {
                  msg.textContent = 'Thanks for subscribing! Please check your email to confirm.';
                  msg.className = 'form-message success';
                  form.reset();
                } else {
                  msg.textContent = response.msg
                    ? response.msg.replace(/<[^>]*>/g, '')
                    : 'Something went wrong — please try again or contact us directly.';
                  msg.className = 'form-message error';
                }
              };

              var script = document.createElement('script');
              script.src = url;
              script.onerror = function() {
                delete window[cbName];
                if (script.parentNode) script.parentNode.removeChild(script);
                btn.disabled = false;
                btn.textContent = 'Subscribe';
                msg.textContent = 'Something went wrong — please try again or contact us directly.';
                msg.className = 'form-message error';
              };
              document.head.appendChild(script);
            });
        </script>
      </div>

      <div class="col5">
        {%- if section.settings.footer_menu_7 != blank -%}
          <nav class="contact">
            {{ section.settings.footer_menu_7 }}
          </nav>
        {%- endif -%}

        <div class="payments">
          <h4>Payments Accepted</h4>
          <picture>
            <source srcset="{{ 'payments_accepted@2x.png' | asset_url }} 2x, {{ 'payments_accepted.png' | asset_url }} 1x" media="(min-width: 200px)">
            <img
              src="{{ 'payments_accepted.png' | asset_url }}"
              alt="payment methods Accepted"
              width="188"
              height="23">
          </picture>
        </div>
      </div>

    </div>

    <div class="copyright">
      <p>&copy; {{ 'now' | date: "%Y" }} Hannah Martin Ltd</p>
    </div>
  </div>
</footer>

{% schema %}
  {
    "name": "Footer",
    "settings": [
      {
        "type": "text",
        "id": "mailchimp_url",
        "label": "Mailchimp subscribe URL",
        "default": "https://dougal.us1.list-manage.com/subscribe/post?u=32bcc9bd8289b8daf8f03523d&id=10803121bb&f_id=00102ee5f0",
        "info": "Paste the full Mailchimp subscribe URL from your audience embed form (e.g. https://xxx.list-manage.com/subscribe/post?u=...)"
      },
      {
        "type": "link_list",
        "id": "footer_menu_1",
        "label": "Collections menu (col1)"
      },
      {
        "type": "link_list",
        "id": "footer_menu_2",
        "label": "Pieces menu (col2 top)"
      },
      {
        "type": "link_list",
        "id": "footer_menu_3",
        "label": "Special menu (col2 bottom)"
      },
      {
        "type": "link_list",
        "id": "footer_menu_4",
        "label": "Online Services menu (col3 top)"
      }, {
        "type": "link_list",
        "id": "footer_menu_5",
        "label": "Follow menu (col3 bottom)"
      }, {
        "type": "link_list",
        "id": "footer_menu_6",
        "label": "About menu (col4)"
      }, {
        "type": "liquid",
        "id": "footer_menu_7",
        "label": "Contact menu (col5)"
      }
    ]
  }
{% endschema %}